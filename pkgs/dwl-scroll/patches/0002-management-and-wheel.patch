+
+static void
+scrollrefresh(void)
+{
+	/* Explicit management actions also reveal an unchanged focused client. */
+	selmon->scrollfocus = NULL;
+	arrange(selmon);
+}
+
+static void
+scrollmovecolumn(const Arg *arg)
+{
+	Client *c = scrollselected();
+	Column *near;
+	if (!c || !(near = scrolladjacent(c->column, arg->i)))
+		return;
+	wl_list_remove(&c->column->link);
+	wl_list_insert(arg->i < 0 ? near->link.prev : &near->link, &c->column->link);
+	scrollrefresh();
+}
+
+static void
+scrollmovewindow(const Arg *arg)
+{
+	Client *c = scrollselected(), *near;
+	if (!c || !(near = scrollvertical(c, arg->i)))
+		return;
+	wl_list_remove(&c->column_link);
+	wl_list_insert(arg->i < 0 ? near->column_link.prev : &near->column_link,
+			&c->column_link);
+	scrollrefresh();
+}
+
+static void
+scrolltransfer(const Arg *arg)
+{
+	Client *c = scrollselected();
+	Column *near;
+	if (!c || !(near = scrolladjacent(c->column, arg->i)))
+		return;
+	scrolldetach(c);
+	c->column = near;
+	wl_list_insert(near->clients.prev, &c->column_link);
+	scrollrefresh();
+}
+
+static void
+scrollsplit(const Arg *arg)
+{
+	Client *c = scrollselected();
+	Column *col;
+	if (!c)
+		return;
+	if (wl_list_length(&c->column->clients) == 1)
+		return;
+	col = scrollnew(selmon, c->column, arg->i);
+	col->fraction = c->column->fraction;
+	col->restore_fraction = c->column->restore_fraction;
+	scrolldetach(c);
+	c->column = col;
+	wl_list_insert(&col->clients, &c->column_link);
+	scrollrefresh();
+}
+
+static void
+scrollmerge(const Arg *arg)
+{
+	Client *c = scrollselected(), *member, *tmp;
+	Column *source, *target;
+	if (!c || !(target = scrolladjacent(c->column, arg->i)))
+		return;
+	source = c->column;
+	/* Leave hidden-tag, floating and fullscreen slots untouched. Defer
+	 * freeing source until iteration finishes, including its last member. */
+	wl_list_for_each_safe(member, tmp, &source->clients, column_link) {
+		if (!scrollvisible(member, selmon))
+			continue;
+		wl_list_remove(&member->column_link);
+		member->column = target;
+		wl_list_insert(target->clients.prev, &member->column_link);
+	}
+	if (wl_list_empty(&source->clients)) {
+		wl_list_remove(&source->link);
+		free(source);
+	}
+	scrollrefresh();
+}
+
+static void
+scrollsetinsert(const Arg *arg)
+{
+	if (scrollactive(selmon))
+		selmon->scrollinsert = arg->i == 2 ? !selmon->scrollinsert : MAX(-1, MIN(1, arg->i));
+}
+
+static void
+scrollwidth(const Arg *arg)
+{
+	Client *c = scrollselected();
+	if (!c)
+		return;
+	c->column->fraction = MAX(0.1f, MIN(1.0f, c->column->fraction + arg->f));
+	c->column->restore_fraction = 0.0f;
+	scrollrefresh();
+}
+
+static void
+scrollpreset(const Arg *arg)
+{
+	Client *c = scrollselected();
+	size_t i;
+	(void)arg;
+	if (!c)
+		return;
+	for (i = 0; i < LENGTH(scroll_widths); i++)
+		if (scroll_widths[i] > c->column->fraction + 0.001f)
+			break;
+	c->column->fraction = scroll_widths[i % LENGTH(scroll_widths)];
+	c->column->restore_fraction = 0.0f;
+	scrollrefresh();
+}
+
+static void
+scrollmaximize(const Arg *arg)
+{
+	Client *c = scrollselected();
+	(void)arg;
+	if (!c)
+		return;
+	if (c->column->restore_fraction > 0.0f) {
+		c->column->fraction = c->column->restore_fraction;
+		c->column->restore_fraction = 0.0f;
+	} else {
+		c->column->restore_fraction = c->column->fraction;
+		c->column->fraction = 1.0f;
+	}
+	scrollrefresh();
+}
