@@ -0,0 +1,247 @@
+/* Persistent scrolling columns for dwl 0.9. Included after client.h. */
+static int
+scrollactive(Monitor *m)
+{
+	return m && m->lt[m->sellt]->arrange == scrolling;
+}
+
+static int
+scrollvisible(Client *c, Monitor *m)
+{
+	return VISIBLEON(c, m) && !c->isfloating && !c->isfullscreen;
+}
+
+static unsigned int
+scrollslot(Monitor *m)
+{
+	uint32_t tags = m->tagset[m->seltags];
+	unsigned int i = 1;
+	if (!tags || (tags & (tags - 1)))
+		return 0;
+	while (tags >>= 1)
+		i++;
+	return i;
+}
+
+static Client *
+scrollfirst(Column *col, Monitor *m)
+{
+	Client *c;
+	wl_list_for_each(c, &col->clients, column_link)
+		if (scrollvisible(c, m))
+			return c;
+	return NULL;
+}
+
+static Column *
+scrollnew(Monitor *m, Column *near, int direction)
+{
+	Column *col = ecalloc(1, sizeof(*col));
+	wl_list_init(&col->clients);
+	col->fraction = MAX(0.1f, MIN(1.0f, scroll_width));
+	wl_list_insert(near ? (direction < 0 ? near->link.prev : &near->link)
+			: m->columns.prev, &col->link);
+	return col;
+}
+
+static void
+scrolldetach(Client *c)
+{
+	Column *col = c->column;
+	if (c->mon && c->mon->scrollfocus == c)
+		c->mon->scrollfocus = NULL;
+	if (!col)
+		return;
+	wl_list_remove(&c->column_link);
+	c->column = NULL;
+	if (wl_list_empty(&col->clients)) {
+		wl_list_remove(&col->link);
+		free(col);
+	}
+}
+
+static void
+scrollattach(Client *c)
+{
+	Client *near;
+	Column *col = NULL;
+	if (c->column || !c->mon || c->isfloating || client_is_unmanaged(c)
+			|| !client_surface(c)->mapped)
+		return;
+	/* The mapping client is already at the head of fstack. Skip it. */
+	wl_list_for_each(near, &fstack, flink) {
+		if (near != c && scrollvisible(near, c->mon) && near->column
+				&& (near->tags & c->tags)) {
+			col = near->column;
+			break;
+		}
+	}
+	if (!col || c->mon->scrollinsert)
+		col = scrollnew(c->mon, col, c->mon->scrollinsert);
+	c->column = col;
+	wl_list_insert(col->clients.prev, &c->column_link);
+}
+
+/* Clip the body AND server-side borders; moving nodes alone leaks columns
+ * onto neighbouring outputs. Popup constraints remain dwl's monitor box. */
+static void
+scrollclip(Client *c, struct wlr_box clip)
+{
+	struct wlr_box area = c->mon->w, part, body;
+	struct wlr_box edges[4] = {
+		{c->geom.x, c->geom.y, c->geom.width, (int)c->bw},
+		{c->geom.x, c->geom.y + c->geom.height - (int)c->bw, c->geom.width, (int)c->bw},
+		{c->geom.x, c->geom.y + (int)c->bw, (int)c->bw, c->geom.height - 2 * (int)c->bw},
+		{c->geom.x + c->geom.width - (int)c->bw, c->geom.y + (int)c->bw,
+			(int)c->bw, c->geom.height - 2 * (int)c->bw}
+	};
+	size_t i;
+	int visible = wlr_box_intersection(&part, &area, &c->geom);
+	wlr_scene_node_set_enabled(&c->scene->node, visible && VISIBLEON(c, c->mon));
+	body = area;
+	/* The clip uses root-surface coordinates, not xdg window geometry. */
+	body.x += clip.x - c->geom.x - (int)c->bw;
+	body.y += clip.y - c->geom.y - (int)c->bw;
+	/* A zero clip disables clipping in wlroots. The whole scene is disabled
+	 * above if the client has no intersection at all. */
+	visible = wlr_box_intersection(&part, &clip, &body);
+	wlr_scene_node_set_enabled(&c->scene_surface->node, visible);
+	if (visible)
+		wlr_scene_subsurface_tree_set_clip(&c->scene_surface->node, &part);
+	for (i = 0; i < LENGTH(edges); i++) {
+		wlr_box_intersection(&part, &area, &edges[i]);
+		wlr_scene_rect_set_size(c->border[i], part.width, part.height);
+		wlr_scene_node_set_position(&c->border[i]->node,
+				part.x - c->geom.x, part.y - c->geom.y);
+	}
+}
+
+static void
+scrolling(Monitor *m)
+{
+	Column *col;
+	Client *c, *focused = focustop(m);
+	struct wlr_box area = m->w, min, max;
+	unsigned int slot = scrollslot(m);
+	int total = 0, n, y, i, height, gap, width;
+	int pad = MIN(MAX(0, scroll_padding), MAX(0, (MIN(area.width, area.height) - 1) / 2));
+	int reveal = focused != m->scrollfocus || m->scrolltags != m->tagset[m->seltags]
+			|| memcmp(&m->scrollarea, &area, sizeof(area));
+	area.x += pad;
+	area.y += pad;
+	area.width = MAX(1, area.width - 2 * pad);
+	area.height = MAX(1, area.height - 2 * pad);
+	width = area.width;
+	wl_list_for_each(col, &m->columns, link) {
+		if (!scrollfirst(col, m))
+			continue;
+		col->x = total;
+		col->width = MAX(1, (int)roundf(col->fraction * (float)width));
+		wl_list_for_each(c, &col->clients, column_link) {
+			if (!scrollvisible(c, m))
+				continue;
+			min = max = (struct wlr_box){0};
+			client_get_size_hints(c, &max, &min);
+			if (min.width <= INT_MAX - 2 * (int)c->bw)
+				col->width = MAX(col->width, min.width + 2 * (int)c->bw);
+		}
+		total += col->width + MAX(0, scroll_column_gap);
+	}
+	total = MAX(0, total - MAX(0, scroll_column_gap));
+	if (reveal && focused && scrollvisible(focused, m) && focused->column) {
+		col = focused->column;
+		if (scroll_center)
+			m->scrolloffset[slot] = col->x + (col->width - width) / 2.0;
+		else if (col->width > width || col->x < m->scrolloffset[slot])
+			m->scrolloffset[slot] = col->x;
+		else if (col->x + col->width > m->scrolloffset[slot] + width)
+			m->scrolloffset[slot] = col->x + col->width - width;
+	}
+	m->scrolloffset[slot] = MAX(0, MIN(m->scrolloffset[slot], MAX(0, total - width)));
+	m->scrollfocus = focused;
+	m->scrolltags = m->tagset[m->seltags];
+	m->scrollarea = m->w;
+	wl_list_for_each(col, &m->columns, link) {
+		n = 0;
+		wl_list_for_each(c, &col->clients, column_link)
+			n += scrollvisible(c, m);
+		if (!n)
+			continue;
+		gap = n > 1 ? MIN(MAX(0, scroll_window_gap), MAX(0, (area.height - n) / (n - 1))) : 0;
+		height = MAX(n, area.height - (n - 1) * gap);
+		i = 0;
+		y = area.y;
+		wl_list_for_each(c, &col->clients, column_link) {
+			if (!scrollvisible(c, m))
+				continue;
+			resize(c, (struct wlr_box){area.x + col->x - (int)round(m->scrolloffset[slot]),
+					y, col->width, height / n + (i < height % n)}, 0);
+			y += height / n + (i++ < height % n) + gap;
+		}
+	}
+}
+
+static Client *
+scrollselected(void)
+{
+	Client *c = focustop(selmon);
+	return scrollactive(selmon) && c && scrollvisible(c, selmon) && c->column ? c : NULL;
+}
+
+static Column *
+scrolladjacent(Column *col, int direction)
+{
+	struct wl_list *p = direction < 0 ? col->link.prev : col->link.next;
+	for (; p != &selmon->columns; p = direction < 0 ? p->prev : p->next) {
+		col = wl_container_of(p, col, link);
+		if (scrollfirst(col, selmon))
+			return col;
+	}
+	return NULL;
+}
+
+static Client *
+scrollvertical(Client *c, int direction)
+{
+	struct wl_list *p = direction < 0 ? c->column_link.prev : c->column_link.next;
+	Column *col = c->column;
+	for (; p != &col->clients; p = direction < 0 ? p->prev : p->next) {
+		c = wl_container_of(p, c, column_link);
+		if (scrollvisible(c, selmon))
+			return c;
+	}
+	return NULL;
+}
+
+static void
+scrollfocuscolumn(const Arg *arg)
+{
+	Client *c = scrollselected(), *target;
+	Column *col;
+	if (!c || !(col = scrolladjacent(c->column, arg->i)))
+		return;
+	/* Prefer the last focused visible member, not global tiling order. */
+	wl_list_for_each(target, &fstack, flink) {
+		if (target->column == col && scrollvisible(target, selmon)) {
+			focusclient(target, 1);
+			return;
+		}
+	}
+}
+
+static void
+scrollfocuswindow(const Arg *arg)
+{
+	Client *c = scrollselected();
+	if (c && (c = scrollvertical(c, arg->i)))
+		focusclient(c, 1);
+}
+
+static void
+scrollpan(const Arg *arg)
+{
+	if (!scrollactive(selmon))
+		return;
+	selmon->scrolloffset[scrollslot(selmon)] += arg->i * scroll_step;
+	arrange(selmon);
+}
