# sops-nix secrets template
# Copy this to hosts/<host>/secrets.yaml and encrypt with sops:
#   SOPS_AGE_KEY_FILE=.sops/keys.txt sops -i hosts/<host>/secrets.yaml
#
# The key file is generated by running `nix run .#setup-sops`

# Asterisk SIP phone passwords
# Usage: set services.asteriskLocal.phones.<name>.passwordSecret = "asterisk/phones/<name>"
asterisk:
  phones:
    desk1: ""
    # desk2: ""

# VoIP provider credentials (Phase 1: structure only, no live trunk yet)
# Usage: set services.voip.clients.<client>.passwordFile = "/run/secrets/voip/<client>"
# and declare the key here so sops-nix creates it:
#   sops.secrets."voip/<client>" = {};
voip:
  easybell-main: ""
  # Eventphone per-event password (Guru3: key icon behind the extension).
  eventphone: ""
  # 2nd EPVPN extension, dedicated fax number.
  eventphone-fax: ""

# Uptime Kuma admin password (local admin user for API sync).
# Usage: services.uptime-kuma-sync.passwordFile = "/run/secrets/uptime-kuma/admin-password"
#   sops.secrets."uptime-kuma/admin-password" = {};
uptime-kuma:
  admin-password: ""

# LLDAP admin password (default admin user, LDAP bind for future consumers).
# Shared read-only into the lldap guest via virtiofs (host-only wiring):
#   sops.secrets."lldap/admin-password" = {};
lldap:
  admin-password: ""

# Add more service secrets below:
# ssh:
#   authorized_keys_extra: ""
# wireguard:
#   private_key: ""
