import "../roles/desktop.purr";
import "../roles/dev.purr";

host x270 {
    use desktop;
    use dev;
    use gaming;

    packages = ["dev"];
    preset gaming-performance;

    // settings.nix
    niri.users = ["lucy"];
    networking.networkmanager.enable = true;
    hardware.bluetooth.enable = true;
    hardware.bluetooth.powerOnBoot = true;
    services.blueman.enable = true;
    hq.deskflow.enable = true;
    virtualisation.libvirtd.enable = false;

    lucy.topology.icon = "devices.laptop";
    lucy.topology.hardware.info = "Lenovo ThinkPad X270 · i7-7600U";
}
