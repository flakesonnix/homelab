// meow.purr — aggregator for `purr check` (all hosts)
// Per-host rebuild uses purr/hosts/<host>.purr via meow.toml [hosts] entrypoints
// → purr rebuild x270 loads purr/hosts/x270.purr
// → purr rebuild mireo loads purr/hosts/mireo.purr
import "purr/hosts/x270.purr";
import "purr/hosts/mireo.purr";
